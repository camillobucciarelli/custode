<?xml version="1.0" encoding="utf-8"?>
<!-- spec 023 T805: the confirming button of PasskeyCreateActivity. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/kv_picker_divider" />
            <corners android:radius="@dimen/kv_picker_radius_field" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/kv_picker_focus" />
            <stroke
                android:width="@dimen/kv_picker_focus_ring"
                android:color="@color/kv_picker_text_primary" />
            <corners android:radius="@dimen/kv_picker_radius_field" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/kv_picker_focus" />
            <corners android:radius="@dimen/kv_picker_radius_field" />
        </shape>
    </item>
</selector>
